[parameter:CustomerId]
Type="Table"
Table="customers.dat"
ColumnName="CustomerId"
Delimiter=","
SelectNextRow="Sequential"
GenerateNewVal="EachIteration"
OutOfRangePolicy="ContinueCyclic"

[parameter:Sku]
Type="Table"
Table="skus.dat"
ColumnName="Sku"
Delimiter=","
SelectNextRow="Random"
GenerateNewVal="EachOccurrence"
OutOfRangePolicy="ContinueCyclic"

[parameter:api_token]
Type="Table"
Table="tokens.dat"
ColumnName="Token"
Delimiter=","
SelectNextRow="Sequential"
GenerateNewVal="Once"
OutOfRangePolicy="ContinueCyclic"

[parameter:RequestTime]
Type="Date/Time"
Format="%Y-%m-%dT%H:%M:%S"
GenerateNewVal="EachOccurrence"
